# Set to true to load /public/models/product.glb (your Blender export)
# instead of the built-in procedural headphones.
VITE_USE_GLB=false

# Optional separately optimized mobile model. Low quality uses this when supplied.
# Leave blank to use the lightweight procedural model on low-tier devices.
VITE_GLB_MOBILE_URL=/models/product-mobile.glb
